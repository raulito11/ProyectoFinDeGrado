Options -Indexes
RewriteEngine On
RewriteBase /ProyectoFinDeGrado/frontend/

# Redirige URLs con .html a la URL limpia (301 permanente)
RewriteCond %{THE_REQUEST} \s/+ProyectoFinDeGrado/frontend/([^?]+)\.html[\s?] [NC]
RewriteRule ^ /ProyectoFinDeGrado/frontend/%1 [R=301,L]

# Sirve el archivo .html cuando se pide la URL sin extension
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
